# Names of the env vars `apl scan --entra` reads. apl does not load this file: export them yourself.
# Read-only app registration, application permissions: Application.Read.All, Directory.Read.All
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# Optional: key for the pseudonyms in reports (app-3f9a1c), at least 16 characters.
# Unset, apl keeps a random one in %APPDATA%\apl\id_salt on Windows or ~/.config/apl/id_salt.
# Set it to the same value on CI and every machine that must report the same finding ids.
# Keep the real value in your secret store. Never commit it.
# Make one: python -c "import secrets; print(secrets.token_hex(32))"
APL_ID_SALT=
